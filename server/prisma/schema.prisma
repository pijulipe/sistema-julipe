  quantidade    Decimal  @default(1.000) @db.Decimal(10, 3)
  combos        combos   @relation(fields: [id_combo], references: [id_combo], onDelete: Restrict, onUpdate: NoAction, map: "fk_itens_combo_combos")
  produtos      produtos @relation(fields: [id_produto], references: [id_produto], onDelete: Restrict, onUpdate: NoAction, map: "fk_itens_combo_produtos")

  @@unique([id_combo, id_produto], map: "uq_itens_combo_combo_produto")
  @@index([id_combo], map: "idx_itens_combo_combo")
  @@index([id_produto], map: "idx_itens_combo_produto")

  horario_entrega_agendada DateTime?             @db.Time(6)
  status_pedido            status_pedido_enum    @default(RECEBIDO)
  status_pagamento         status_pagamento_enum @default(PENDENTE)
  valor_subtotal           Decimal               @default(0.00) @db.Decimal(10, 2)
  taxa_entrega             Decimal               @default(0.00) @db.Decimal(10, 2)
  desconto_percentual      Decimal               @default(0.00) @db.Decimal(5, 2)
  valor_desconto           Decimal               @default(0.00) @db.Decimal(10, 2)
  valor_total              Decimal               @default(0.00) @db.Decimal(10, 2)
  forma_pagamento          String?               @db.VarChar(100)
  peixe_status_cor         peixe_status_cor_enum @default(NENHUM)
  estoque_baixado          Boolean               @default(false)
  foto_referencia_url      String?
  observacoes_pedido       String?
  detalhes_personalizacao  String?
  motivo_cancelamento      String?
  cancelado_em             DateTime?             @db.Timestamptz(6)
  item_ativo               Boolean               @default(true)
  deletado_em              DateTime?             @db.Timestamptz(6)
  acessorios_pedido        acessorios_pedido[]
  clientes                 Cliente?              @relation(fields: [id_cliente], references: [idCliente], onUpdate: NoAction, map: "fk_pedidos_clientes")
  entregadores             entregadores?         @relation(fields: [id_entregador], references: [id_entregador], onUpdate: NoAction, map: "fk_pedidos_entregadores")
  limites_horario          limites_horario?      @relation(fields: [id_limite_horario], references: [id_limite_horario], onUpdate: NoAction, map: "fk_pedidos_limites_horario")
  usuario                  Usuario?              @relation(fields: [id_usuario_atendente], references: [idUsuario], onUpdate: NoAction, map: "fk_pedidos_usuarios")
  propriedades_pedido      propriedades_pedido[]

  @@index([id_usuario_atendente], map: "idx_pedidos_atendente")
  @@index([id_cliente], map: "idx_pedidos_cliente")
  @@index([id_entregador], map: "idx_pedidos_entregador")
  @@index([id_limite_horario], map: "idx_pedidos_limite_horario")
}


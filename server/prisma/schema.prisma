generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  idCliente       BigInt    @id(map: "pk_clientes") @default(autoincrement()) @map("id_cliente")
  nome            String    @db.VarChar(255)
  telefone        String    @db.VarChar(20)
  endereco        String?   @db.VarChar(255)
  numeroEndereco  String?   @map("numero_endereco") @db.VarChar(20)
  bairro          String?   @db.VarChar(100)
  pontoReferencia String?   @map("ponto_referencia") @db.VarChar(255)
  observacoes     String?
  dataAniversario DateTime? @map("data_aniversario") @db.Date
  dataCadastro    DateTime  @default(now()) @map("data_cadastro") @db.Timestamptz(6)
  itemAtivo       Boolean   @default(true) @map("item_ativo")
  deletadoEm      DateTime? @map("deletado_em") @db.Timestamptz(6)
  pedidos         pedidos[]

  @@map("clientes")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model acessorios {
  id_acessorio      Int                 @id(map: "pk_acessorios") @default(autoincrement())
  nome              String              @db.VarChar(255)
  preco_padrao      Decimal             @default(0.00) @db.Decimal(10, 2)
  estoque_atual     Int                 @default(0)
  ativo             Boolean             @default(true)
  item_ativo        Boolean             @default(true)
  deletado_em       DateTime?           @db.Timestamptz(6)
  acessorios_pedido acessorios_pedido[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model acessorios_pedido {
  id_acessorio_pedido Int        @id(map: "pk_acessorios_pedido") @default(autoincrement())
  id_pedido           BigInt
  id_acessorio        Int
  quantidade          Int        @default(1)
  preco_unitario      Decimal    @db.Decimal(10, 2)
  item_ativo          Boolean    @default(true)
  deletado_em         DateTime?  @db.Timestamptz(6)
  acessorios          acessorios @relation(fields: [id_acessorio], references: [id_acessorio], onUpdate: NoAction, map: "fk_acessorios_pedido_acessorios")
  pedidos             pedidos    @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade, onUpdate: NoAction, map: "fk_acessorios_pedido_pedidos")

  @@index([id_acessorio], map: "idx_acessorios_pedido_acessorio")
  @@index([id_pedido], map: "idx_acessorios_pedido_pedido")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categorias {
  id_categoria               Int        @id(map: "pk_categorias") @default(autoincrement())
  nome_categoria             String     @db.VarChar(150)
  descricao                  String?
  unidades_por_pacote_padrao Int        @default(1)
  permite_imagem             Boolean    @default(false)
  ativo                      Boolean    @default(true)
  item_ativo                 Boolean    @default(true)
  deletado_em                DateTime?  @db.Timestamptz(6)
  produtos                   produtos[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
